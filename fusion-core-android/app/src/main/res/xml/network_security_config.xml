<?xml version="1.0" encoding="utf-8"?>
<!--
  The treasury RPC and Hugging Face model mirror are HTTPS, so cleartext stays OFF for the
  public internet. The only cleartext peers are the loopback and the operator's LAN model
  mirror used by ModelDownloader when the device provisions LFM2.5-230M from a local server
  (manifest URLs are local-first). No treasury traffic ever uses these.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.0.102</domain>
    </domain-config>
</network-security-config>
